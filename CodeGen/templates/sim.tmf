MODEL = $$MODEL$$

ifeq ($(OS),Windows_NT)
EXE = .exe
SYS_LIBS = -lws2_32
else ifeq ($(shell uname -s),Linux)
LDFLAGS_OS = -static
SYS_LIBS = -lrt
endif

all: ../$(MODEL)$(EXE)

PYCODEGEN = $(PYSUPSICTRL)/CodeGen
MAINDIR = $(PYCODEGEN)/src
LIBDIR  = $(PYCODEGEN)/sim/lib
INCDIR  = $(PYCODEGEN)/sim/include
COMMON_INCDIR = $(PYCODEGEN)/Common/include

# GSL, used by the variable step solvers
GSL_CFLAGS = $(shell gsl-config --cflags)
GSL_LIBS   = $(shell gsl-config --libs)

RM = rm -f
FILES_TO_CLEAN = *.o $(MODEL)

CC = gcc
CC_OPTIONS = -g

MAIN = sim_main
ADD_FILES = $$ADD_FILES$$

OBJSSTAN = $(MAIN).o $(MODEL).o $(ADD_FILES)

LIB = $(LIBDIR)/libpyblk.a $(FMILIB)

CFLAGS = $(CC_OPTIONS) -O2 -I$(INCDIR) -I$(COMMON_INCDIR) $(GSL_CFLAGS) $(C_FLAGS) -DMODEL=$(MODEL)

$(MAIN).c: $(MAINDIR)/$(MAIN).c $(MODEL).c
	cp $< .

%.o: %.c
	$(CC) -c -o $@ $(CFLAGS) $<

../$(MODEL)$(EXE): $(OBJSSTAN) $(LIB)
	$(CC) $(LDFLAGS_OS) -o $@ $(OBJSSTAN) $(LIB) $(GSL_LIBS) -lpthread $(SYS_LIBS) -lm
	@echo "### Created executable: $(MODEL)"

clean::
	@$(RM) $(FILES_TO_CLEAN)
